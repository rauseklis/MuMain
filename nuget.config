<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- The packet packages (MUnique.OpenMU.PlugIns, .Network, .Network.Packets) the server's protocol is built from.
         They are packed from the server repository and kept here, so a clone, the CI and every developer restore the same
         version without a package server or a token. See nuget-feed/README.md. -->
    <add key="repo-packets" value="nuget-feed" />
  </packageSources>
</configuration>
