# Every BMD member that reads the shared VertexTransform scratch must first materialize it with EnsureCpuVertices():
# Transform() only stashes the skin request. A consumer that skips it reads whatever model last filled the array
# (the "yellow folded planes": Zen coin heaps drawn with another model's vertices).
if(NOT DEFINED MU_BMD_SOURCE)
    message(FATAL_ERROR "MU_BMD_SOURCE must point at ZzzBMD.cpp")
endif()

file(READ "${MU_BMD_SOURCE}" source)
string(REGEX MATCHALL "\n[a-z]+ BMD::[A-Za-z0-9_]+[(]" function_starts "${source}")
set(producers "BMD::SkinVertices(" "BMD::EnsureCpuNormals(")
set(offenders "")
set(checked 0)
foreach(start IN LISTS function_starts)
    string(STRIP "${start}" signature)
    string(FIND "${source}" "${start}" start_pos)
    string(SUBSTRING "${source}" ${start_pos} -1 rest)
    string(SUBSTRING "${rest}" 1 -1 after_signature)
    string(REGEX MATCH "\n[a-z]+ BMD::[A-Za-z0-9_]+[(]" next_start "${after_signature}")
    if(next_start)
        string(FIND "${after_signature}" "${next_start}" next_pos)
        string(SUBSTRING "${after_signature}" 0 ${next_pos} body)
    else()
        set(body "${after_signature}")
    endif()
    string(FIND "${body}" "VertexTransform[" reads)
    if(reads EQUAL -1)
        continue()
    endif()
    math(EXPR checked "${checked} + 1")
    string(FIND "${body}" "EnsureCpuVertices" ensures)
    if(ensures EQUAL -1)
        string(REGEX MATCH "BMD::[A-Za-z0-9_]+[(]" name "${signature}")
        list(FIND producers "${name}" is_producer)
        if(is_producer EQUAL -1)
            list(APPEND offenders "${name}")
        endif()
    endif()
endforeach()

if(checked LESS 5)
    message(FATAL_ERROR "contract scan found only ${checked} consumers; the scan is broken")
endif()
if(offenders)
    message(FATAL_ERROR "BMD members read VertexTransform without EnsureCpuVertices(): ${offenders}")
endif()
message(STATUS "all ${checked} VertexTransform consumers materialize their vertices")
