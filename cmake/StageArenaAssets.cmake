foreach(required IN ITEMS MU_ARENA_SOURCE MU_ARENA_OUTPUT MU_ARENA_MANIFEST)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

file(READ "${MU_ARENA_MANIFEST}" manifest)
string(JSON asset_count LENGTH "${manifest}")
if(asset_count LESS 1)
    message(FATAL_ERROR "Arena manifest is empty")
endif()
math(EXPR last_asset "${asset_count} - 1")
foreach(index RANGE ${last_asset})
    string(JSON relative GET "${manifest}" ${index} Path)
    string(JSON expected_hash GET "${manifest}" ${index} SHA256)
    string(REPLACE "\\" "/" relative "${relative}")
    if(NOT relative MATCHES "^(World7|Object7)/[^/]+$" OR relative MATCHES "[.][.]")
        message(FATAL_ERROR "Unsafe Arena asset path: ${relative}")
    endif()
    set(source "${MU_ARENA_SOURCE}/${relative}")
    set(destination "${MU_ARENA_OUTPUT}/${relative}")
    file(SHA256 "${source}" actual_hash)
    string(TOUPPER "${actual_hash}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Arena source differs from manifest: ${relative}")
    endif()
    get_filename_component(directory "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${source}" "${destination}" ONLY_IF_DIFFERENT)
    file(SHA256 "${destination}" staged_hash)
    string(TOUPPER "${staged_hash}" staged_hash)
    if(NOT staged_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Arena runtime asset verification failed: ${relative}")
    endif()
endforeach()
message(STATUS "Verified ${asset_count} full Arena runtime assets")
